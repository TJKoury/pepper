      PARAMETER           ( SETTBF = 'SET TBFAST' )

      CHARACTER*(*)         BADDIR
      PARAMETER           ( BADDIR = 'BAD DIRECTORY' )

      CHARACTER*(*)         GETACC
      PARAMETER           ( GETACC = 'LOOK UP ACCESS METHOD' )

